.DS_Store
.git
.gitignore
.stow-local-ignore
.*.example
^/@.*
README.*

# Stow never reads .gitignore, so a regenerable artifact left in a package is
# still a link candidate: stow tries to install it, collides with the real copy
# already in $HOME, and aborts the WHOLE package rather than that one path. A
# `bun install` inside a folded .omp/plugins put 89MB of node_modules in
# dotfiles-private and wedged `stow -R omp-private` on 244 conflicts.
node_modules
__pycache__
.venv

# ~/.omp/agent/managed-skills belongs to OMP: setup.sh keeps it a git worktree,
# and manage_skill refuses to write through any stow link. A stray package copy
# (an old checkout, a hand-written skill) must never reach it: stow would plant
# a symlinked skill OMP will not update, or abort the whole package on the
# first real SKILL.md it collides with.
^/\.omp/agent/managed-skills$
