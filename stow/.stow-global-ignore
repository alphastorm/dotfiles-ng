.DS_Store
.git
.gitignore
.stow-local-ignore
.*.example
^/@.*
README.*

# Stow never reads .gitignore, so a regenerable artifact left in a package is
# still a link candidate: stow tries to install it, collides with the real copy
# already in $HOME, and aborts the WHOLE package rather than that one path. A
# `bun install` inside a folded .omp/plugins put 89MB of node_modules in
# dotfiles-private and wedged `stow -R omp-private` on 244 conflicts.
node_modules
__pycache__
.venv

# Directories an OMP runtime writer owns. setup.sh keeps each one a git worktree,
# because the writers refuse stow's links (manage_skill) or rename files over
# them (bun saving bun.lock). A stray package copy -- an old checkout, a
# hand-written file -- must never reach them: stow would plant a link the writer
# then breaks, or abort the whole package on the first real file it collides with.
^/\.omp/agent/managed-skills$
^/\.omp/plugins$
