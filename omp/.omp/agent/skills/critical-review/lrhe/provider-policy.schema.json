{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lrhe/provider-policy.schema.json",
  "title": "LRHE provider route policy registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policies"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/policy"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "providerRoute",
        "accountType",
        "dataAllowlistKey",
        "termsSnapshotId",
        "providerTrainingUse",
        "providerRetention",
        "rawOutputCaptureStatus",
        "internalEvaluationAllowed",
        "routerTrainingAllowed",
        "modelTrainingAllowed",
        "publicCorpusAllowed",
        "carrythroughOwnedInternalAllowed",
        "customerDataAllowed",
        "thirdPartyConfidentialAllowed"
      ],
      "properties": {
        "policyId": {"type": "string", "minLength": 1},
        "providerRoute": {"type": "string", "minLength": 1},
        "accountType": {"type": "string", "minLength": 1},
        "dataAllowlistKey": {"type": "string", "minLength": 1,
          "description": "the token this route must find in a corpus item's provider_data_allowlist. Routes are named per account (opencode-go); allowlists are named per vendor (opencode), because the licence decision is about who receives the material, not which billing path carried it"},
        "termsSnapshotId": {"type": "string", "minLength": 1},
        "termsSnapshotDigest": {"type": "string"},
        "providerTrainingUse": {
          "type": "string",
          "enum": [
            "prohibited_by_provider_documentation",
            "opt_out_required",
            "explicit_opt_in_only",
            "permitted",
            "contract_pending",
            "unknown"
          ]
        },
        "providerRetention": {
          "type": "string",
          "enum": [
            "zero_retention_by_provider_documentation",
            "consumer_standard_not_zdr",
            "limited_transient_processing",
            "30_day_standard",
            "contract_specific",
            "unknown"
          ]
        },
        "gatewayContentRetention": {"type": "string"},
        "outputOwnership": {"type": "string"},
        "rawOutputCaptureStatus": {
          "type": "string",
          "enum": ["allowed", "internal_evaluation_only", "contract_pending", "prohibited"]
        },
        "internalEvaluationAllowed": {"type": "boolean"},
        "routerTrainingAllowed": {"type": "boolean"},
        "modelTrainingAllowed": {"type": "boolean"},
        "publicCorpusAllowed": {"type": "boolean"},
        "routerUseAllowed": {"type": "boolean"},
        "termsClearanceStatus": {
          "type": "string",
          "enum": ["vendor_confirmed_in_writing", "operator_risk_accepted_pending_written_clarification",
                   "contract_pending", "unknown"],
          "description": "how the permissive values in this policy are justified. `operator_risk_accepted...` means a human decided to proceed under acknowledged contractual ambiguity -- it is NOT a vendor clearance, and a later reply upgrades it rather than confirming it"
        },
        "legalReviewStatus": {"type": "string"},
        "termsClarificationStatus": {
          "type": "string",
          "enum": ["not_sent", "pending_nonblocking", "pending_blocking", "answered", "refused"]
        },
        "operatorAuthorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["principal", "capacity", "effectiveDate", "scope"],
          "description": "provenance for a risk acceptance. A permissive policy with no named principal and no dated record is an assertion nobody owns",
          "properties": {
            "principal": {"type": "string", "minLength": 1},
            "capacity": {"type": "string", "enum": ["individual", "entity"]},
            "effectiveDate": {"type": "string", "format": "date"},
            "scope": {"type": "string", "minLength": 1},
            "recordPath": {"type": "string"},
            "recordSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "carrythroughOwnedInternalAllowed": {"type": "boolean"},
        "customerDataAllowed": {"type": "boolean"},
        "thirdPartyConfidentialAllowed": {"type": "boolean"},
        "requiredControls": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "boolean", "number", "null"]
          }
        },
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
