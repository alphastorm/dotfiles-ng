{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lrhe/review-dispatch-envelope.schema.json",
  "title": "Critical Review Dispatch Envelope",
  "description": "The exact native Task payload authorized by one verified receipt and rebuilt from frozen bytes before dispatch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "panelId",
    "leadFamily",
    "reviewClass",
    "subjectDigest",
    "receiptPath",
    "receiptSha256",
    "taskIntent",
    "tasks",
    "tasksSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "panelId": {
      "type": "string",
      "minLength": 1
    },
    "leadFamily": {
      "enum": [
        "gpt",
        "claude"
      ]
    },
    "reviewClass": {
      "enum": [
        "canary",
        "focused",
        "replay",
        "initial",
        "targeted-refuter"
      ]
    },
    "subjectDigest": {
      "$ref": "#/$defs/sha256"
    },
    "receiptPath": {
      "type": "string",
      "pattern": "^/"
    },
    "receiptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "taskIntent": {
      "const": "Dispatching resolved reviewers"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "tasksSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "task"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^review-[a-z0-9-]+$"
        },
        "task": {
          "type": "string",
          "pattern": "^CRITICAL_REVIEW_RESOLVER_RECEIPT_V1\\n",
          "minLength": 1
        }
      }
    }
  }
}
