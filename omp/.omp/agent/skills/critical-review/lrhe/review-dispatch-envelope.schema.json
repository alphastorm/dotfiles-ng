{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lrhe/review-dispatch-envelope.schema.json",
  "title": "Critical Review Dispatch Envelope",
  "description": "The exact native Task payload and non-authoritative Oracle shadow selection authorized by one verified receipt and rebuilt from frozen bytes before dispatch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "panelId",
    "leadFamily",
    "reviewClass",
    "subjectDigest",
    "receiptPath",
    "receiptSha256",
    "taskIntent",
    "tasks",
    "tasksSha256",
    "oracleShadow"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "panelId": {
      "type": "string",
      "minLength": 1
    },
    "leadFamily": {
      "enum": [
        "gpt",
        "claude"
      ]
    },
    "reviewClass": {
      "enum": [
        "focused",
        "initial",
        "targeted-refuter"
      ]
    },
    "subjectDigest": {
      "$ref": "#/$defs/sha256"
    },
    "receiptPath": {
      "type": "string",
      "pattern": "^/"
    },
    "receiptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "taskIntent": {
      "const": "Dispatching resolved reviewers"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "tasksSha256": {
      "$ref": "#/$defs/sha256"
    },
    "oracleShadow": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/oracleShadow"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reviewClass": {
            "const": "initial"
          }
        },
        "required": [
          "reviewClass"
        ]
      },
      "then": {
        "properties": {
          "oracleShadow": {
            "$ref": "#/$defs/oracleShadow"
          }
        }
      },
      "else": {
        "properties": {
          "oracleShadow": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "task"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^review-[a-z0-9-]+$"
        },
        "task": {
          "type": "string",
          "pattern": "^CRITICAL_REVIEW_RESOLVER_RECEIPT_V1\\n",
          "minLength": 1
        }
      }
    },
    "oracleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryPath",
        "subjectCommit",
        "files",
        "prompt",
        "promptSha256"
      ],
      "properties": {
        "repositoryPath": {
          "type": "string",
          "pattern": "^/"
        },
        "subjectCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]+$"
          }
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "pattern": "^CRITICAL_REVIEW_ORACLE_SHADOW_V1\\n"
        },
        "promptSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "oracleShadow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reviewId",
        "requestPath",
        "dispatchPath",
        "resultPath",
        "datasetRecordPath",
        "shadowId",
        "modelFamily",
        "correlationGroup",
        "providerRoute",
        "accessProfile",
        "dataAllowlistKey",
        "preset",
        "executionMode",
        "evidenceDelivery",
        "selection",
        "reasonCodes",
        "standing",
        "blocksClosure",
        "receivesPeerOutput",
        "request"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "shadowId": {
          "type": "string",
          "minLength": 1
        },
        "modelFamily": {
          "type": "string",
          "minLength": 1
        },
        "correlationGroup": {
          "type": "string",
          "minLength": 1
        },
        "providerRoute": {
          "type": "string",
          "minLength": 1
        },
        "accessProfile": {
          "type": "string",
          "minLength": 1
        },
        "dataAllowlistKey": {
          "type": "string",
          "minLength": 1
        },
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "executionMode": {
          "const": "pi_oracle_async"
        },
        "evidenceDelivery": {
          "const": "repository"
        },
        "selection": {
          "enum": [
            "selected",
            "skipped",
            "disabled"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "standing": {
          "const": "none"
        },
        "blocksClosure": {
          "const": false
        },
        "receivesPeerOutput": {
          "const": false
        },
        "request": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/oracleRequest"
            }
          ]
        },
        "reviewId": {
          "type": "string",
          "minLength": 1
        },
        "requestPath": {
          "type": "string",
          "pattern": "^/"
        },
        "dispatchPath": {
          "type": "string",
          "pattern": "^/"
        },
        "resultPath": {
          "type": "string",
          "pattern": "^/"
        },
        "datasetRecordPath": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selection": {
                "const": "selected"
              }
            },
            "required": [
              "selection"
            ]
          },
          "then": {
            "properties": {
              "reasonCodes": {
                "maxItems": 0
              },
              "request": {
                "$ref": "#/$defs/oracleRequest"
              }
            }
          },
          "else": {
            "properties": {
              "reasonCodes": {
                "minItems": 1
              },
              "request": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
