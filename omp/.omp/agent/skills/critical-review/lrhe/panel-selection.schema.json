{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lrhe/panel-selection.schema.json",
  "title": "Critical Review Panel Selection",
  "description": "One resolver-owned council roster with one strong critic, always-on supplements, and record-selected architecture specialists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "panelId", "mode", "leadFamily", "reviewRecordPath",
    "reviewRecordSha256", "subjectDigest", "packetPath", "packetSha256",
    "qualificationPath", "qualificationSha256", "authorityPath",
    "authoritySha256", "selected", "skipped"
  ],
  "properties": {
    "schemaVersion": { "const": 8 },
    "panelId": { "const": "critical-review-primary-v6" },
    "mode": { "enum": ["initial", "targeted-refuter"] },
    "leadFamily": { "enum": ["gpt", "claude"] },
    "reviewRecordPath": { "type": "string", "pattern": "^/" },
    "reviewRecordSha256": { "$ref": "#/$defs/sha256" },
    "subjectDigest": { "$ref": "#/$defs/sha256" },
    "packetPath": { "type": "string", "pattern": "^/" },
    "packetSha256": { "$ref": "#/$defs/sha256" },
    "qualificationPath": { "const": "lrhe/qualification.py" },
    "qualificationSha256": { "$ref": "#/$defs/sha256" },
    "authorityPath": { "type": "string", "pattern": "^/" },
    "authoritySha256": { "$ref": "#/$defs/sha256" },
    "selected": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/selectedReviewer" }
    },
    "skipped": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/skippedReviewer" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "initial" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "selected": {
            "contains": {
              "properties": { "role": { "const": "strong_critic" } },
              "required": ["role"]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "targeted-refuter" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "selected": {
            "items": {
              "properties": {
                "role": { "const": "targeted_refuter" },
                "selectionClass": { "const": "targeted" }
              }
            }
          },
          "skipped": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reasonCode": {
      "enum": [
        "access-profile-not-authorized",
        "architecture-design-council",
        "architecture-material",
        "architecture-material-redesign",
        "architecture-scope-absent",
        "authorization-proof-applicable",
        "configured-strong-critic",
        "configured-supplement",
        "configured-targeted-refuter",
        "provider-data-rights-not-authorized",
        "review-mode-ineligible",
        "risk-domains-empty",
        "security-risk-domain",
        "security-sensitive-path"
      ]
    },
    "selectedReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id", "model_family", "correlation_group", "provider_route",
        "access_profile", "data_allowlist_key", "execution_mode", "role",
        "independence_class", "authority", "agent", "lens", "model",
        "evidence_delivery", "selectionClass", "reasonCodes"
      ],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "model_family": { "type": "string", "minLength": 1 },
        "correlation_group": { "type": "string", "minLength": 1 },
        "provider_route": { "type": "string", "minLength": 1 },
        "access_profile": { "type": "string", "minLength": 1 },
        "data_allowlist_key": { "type": "string", "minLength": 1 },
        "execution_mode": { "const": "task_agent" },
        "role": {
          "enum": ["strong_critic", "supplement", "architecture_specialist", "targeted_refuter"]
        },
        "independence_class": { "enum": ["cross_family", "same_lineage_blind_sample"] },
        "authority": { "enum": ["independent_evidence", "supplemental_evidence"] },
        "agent": { "type": "string", "minLength": 1 },
        "lens": { "type": "string" },
        "model": { "type": "string", "minLength": 1 },
        "evidence_delivery": { "enum": ["inline", "repository"] },
        "selectionClass": { "enum": ["strong", "supplement", "conditional", "targeted"] },
        "reasonCodes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/reasonCode" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "enum": ["strong_critic", "targeted_refuter"] } }, "required": ["role"] },
          "then": {
            "properties": {
              "independence_class": { "const": "cross_family" },
              "authority": { "const": "independent_evidence" }
            }
          }
        },
        {
          "if": { "properties": { "role": { "const": "supplement" } }, "required": ["role"] },
          "then": {
            "properties": {
              "independence_class": { "const": "cross_family" },
              "authority": { "const": "supplemental_evidence" },
              "selectionClass": { "const": "supplement" },
              "reasonCodes": { "items": { "const": "configured-supplement" } }
            }
          }
        },
        {
          "if": { "properties": { "role": { "const": "architecture_specialist" } }, "required": ["role"] },
          "then": {
            "properties": {
              "authority": { "const": "supplemental_evidence" },
              "selectionClass": { "const": "conditional" },
              "reasonCodes": {
                "items": {
                  "enum": [
                    "architecture-design-council", "architecture-material",
                    "architecture-material-redesign"
                  ]
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "selectionClass": { "const": "strong" } }, "required": ["selectionClass"] },
          "then": {
            "properties": {
              "role": { "const": "strong_critic" },
              "reasonCodes": { "items": { "const": "configured-strong-critic" } }
            }
          }
        },
        {
          "if": { "properties": { "selectionClass": { "const": "targeted" } }, "required": ["selectionClass"] },
          "then": {
            "properties": {
              "role": { "const": "targeted_refuter" },
              "reasonCodes": { "items": { "const": "configured-targeted-refuter" } }
            }
          }
        }
      ]
    },
    "skippedReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "selectionClass", "reasonCodes"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "selectionClass": { "const": "conditional" },
        "reasonCodes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "enum": [
              "access-profile-not-authorized", "architecture-scope-absent",
              "authorization-proof-applicable", "provider-data-rights-not-authorized",
              "review-mode-ineligible", "risk-domains-empty", "security-risk-domain",
              "security-sensitive-path"
            ]
          }
        }
      }
    }
  }
}
