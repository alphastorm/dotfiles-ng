,{"id":"zh-TW","absoluteUrl":"https://privacy.claude.com/zh-TW/articles/10023580-我的數據是否用於模型訓練","available":true,"name":"繁體中文","selected":false,"url":"/zh-TW/articles/10023580-我的數據是否用於模型訓練"}],"requestContext":{"articleSource":null,"academy":false,"canonicalUrl":"https://privacy.claude.com/en/articles/10023580-is-my-data-used-for-model-training","experience":"legacy","headerless":false,"isDefaultDomainRequest":false,"nonce":"EsMIWO9QIoFt6d9ytAGnAsisz0GrlarX50SBUaAWZH4=","rootUrl":"/en/","sheetUserCipher":null,"type":"help-center"},"theme":{"color":"009cc7","siteName":"Anthropic Privacy Center","headline":"Anthropic Privacy Center","headerFontColor":"191919","logo":"https://downloads.intercomcdn.com/i/o/lupk8zyo/588497/6bf24bcf9f4bc4c775cd77efdb83/8ad5679fcafe1fac29d2b8d78ccb67a6.png","logoHeight":"280","header":null,"favicon":"https://intercom.help/privacy-center/assets/favicon","locale":"en","homeUrl":null,"social":null,"urlPrefixForDefaultDomain":"https://intercom.help/privacy-center","customDomain":"privacy.claude.com","customDomainUsesSsl":true,"customizationOptions":{"customizationType":1,"header":{"backgroundColor":"#F0EFEB","fontColor":"#191919","fadeToEdge":false,"backgroundGradient":null,"backgroundImageId":null,"backgroundImageUrl":null},"body":{"backgroundColor":"#ffffff","fontColor":null,"fadeToEdge":null,"backgroundGradient":null,"backgroundImageId":null},"footer":{"backgroundColor":"#191919","fontColor":"#F0f0eb","fadeToEdge":null,"backgroundGradient":null,"backgroundImageId":null,"showRichTextField":false},"layout":{"homePage":{"blocks":[{"type":"tickets-portal-link","enabled":false},{"type":"collection-list","columns":2,"template":0},{"type":"article-list","columns":2,"enabled":false,"localizedContent":[{"title":"","locale":"en","links":[{"articleId":"empty_article_slot","type":"article-link"},{"articleId":"empty_article_slot","type":"article-link"},{"articleId":"empty_article_slot","type":"article-link"},{"articleId":"empty_article_slot","type":"article-link"},{"articleId":"empty_article_slot","type":"article-link"},{"articleId":"empty_article_slot","type":"article-link"}]}]},{"type":"content-block","enabled":false,"columns":1}]},"collectionsPage":{"showArticleDescriptions":false},"articlePage":{},"searchPage":{}},"collectionCard":{"global":{"backgroundColor":"#CC785C","fontColor":"#F0F0EB","fadeToEdge":null,"backgroundGradient":null,"backgroundImageId":null,"showIcons":true,"backgroundImageUrl":null},"collections":[]},"global":{"font":{"customFontFaces":[{"assetId":589148,"fileName":"TiemposText-Regular.otf","fontFamily":"Tiempos Text Regular","weight":400,"style":"normal","url":"https://privacy.claude.com/assets/font/589148"}],"primary":"Tiempos Text Regular","secondary":null},"componentStyle":{"card":{"type":"bordered","borderRadius":14}},"namedComponents":{"header":{"subheader":{"enabled":false,"style":{"backgroundColor":"#000000","fontColor":"#FFFFFF"}},"style":{"height":"245px","align":"center","justify":"end"}},"searchBar":{"style":{"width":"100%","borderRadius":10}},"footer":{"type":1}},"brand":{"colors":[],"websiteUrl":""},"showDotTexture":null,"showCopyForLlm":null},"contentBlock":{"blockStyle":{"backgroundColor":"#ffffff","fontColor":"#1a1a1a","fadeToEdge":null,"backgroundGradient":null,"backgroundImageId":null,"backgroundImageUrl":null},"buttonOptions":{"backgroundColor":"#334BFA","fontColor":"#ffffff","borderRadius":6},"isFullWidth":false,"align":null}},"helpCenterName":"Privacy Center","footerLogo":"https://downloads.intercomcdn.com/i/o/lupk8zyo/589147/0f6a8b2e289e487afce6e2749695/31367edc0f1b659767b4d77403818b20.png","footerLogoHeight":"280","localisedInformation":{"contentBlock":{"locale":"en","title":"Content section title","withButton":false,"description":"","buttonTitle":"Button title","buttonUrl":""}}},"articleContent":{"articleId":"10023580","author":null,"blocks":[{"type":"paragraph","text":"\u003ci\u003eThis article is about our consumer products such as Claude Free, Pro, Max and when accounts from those plans use Claude Code. For our commercial products such as Claude for Work and the Anthropic API, see \u003c/i\u003e\u003ci\u003e\u003ca href=\"https://privacy.anthropic.com/en/articles/7996868-is-my-data-used-for-model-training\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"\u003ehere\u003c/a\u003e.\u003c/i\u003e","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":"We will use your chats and coding sessions (including  to improve our models) if: ","class":"no-margin"},{"type":"orderedNestedList","text":"1. You choose to allow us to use your chats and coding sessions to improve Claude, learn more \u003ca href=\"https://privacy.anthropic.com/en/articles/12109829-how-do-i-change-my-model-improvement-privacy-settings\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"\u003ehere\u003c/a\u003e\n2. Your conversations are flagged for safety review (in which case we may use or analyze them to improve our ability to detect and enforce our \u003ca href=\"https://www.anthropic.com/legal/aup\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"\u003eUsage Policy\u003c/a\u003e, including training models for use by our Safeguards team, consistent with Anthropic’s safety mission)\n3. By otherwise explicitly opting in to training (e.g. joining our Trusted Tester Program)","items":[{"content":[{"type":"paragraph","text":"You choose to allow us to use your chats and coding sessions to improve Claude, learn more \u003ca href=\"https://privacy.anthropic.com/en/articles/12109829-how-do-i-change-my-model-improvement-privacy-settings\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"\u003ehere\u003c/a\u003e","class":"no-margin"}]},{"content":[{"type":"paragraph","text":"Your conversations are flagged for safety review (in which case we may use or analyze them to improve our ability to detect and enforce our \u003ca href=\"https://www.anthropic.com/legal/aup\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"\u003eUsage Policy\u003c/a\u003e, including training models for use by our Safeguards team, consistent with Anthropic’s safety mission)","class":"no-margin"}]},{"content":[{"type":"paragraph","text":"By otherwise explicitly opting in to training (e.g. joining our Trusted Tester Program)","class":"no-margin"}]}]},{"type":"paragraph","text":"Chat and coding session data we may use for improving our models includes the entire related conversation, along with any content, custom styles or conversation preferences, as well as data collected when using \u003ca href=\"https://support.anthropic.com/en/articles/12012173-getting-started-with-claude-for-chrome\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"\u003eClaude for Chrome\u003c/a\u003e. It does not include raw content from connectors (e.g. Google Drive), including remote and local MCP servers, though data may be included if it’s directly copied into your conversation with Claude.","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"subheading","text":"Incognito chats","idAttribute":"h_e0f0d7ddb1"},{"type":"paragraph","text":"Your Incognito chats are not used to improve Claude, even if you have enabled Model Improvement in your \u003ca href=\"https://claude.ai/settings/data-privacy-controls\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"\u003ePrivacy Settings\u003c/a\u003e. \u003ca href=\"https://support.anthropic.com/en/articles/12260368-using-incognito-chats\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"\u003eLearn more\u003c/a\u003e about incognito chats.  ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"subheading","text":"Feedback","idAttribute":"h_35233e8c7a"},{"type":"paragraph","text":"When you provide us feedback via our thumbs up/down button, we will store the entire related conversation, including any content, custom styles or conversation preferences, in our secured back-end for up to 5 years. Feedback data does not include raw content from \u003ca href=\"https://support.anthropic.com/en/articles/10168395-setting-up-integrations-on-claude-ai\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"\u003econnectors\u003c/a\u003e (e.g. Google Drive), including remote and local MCP servers, though data may be included if it’s directly copied into your conversation with Claude.","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":"We de-link your feedback from your user ID (e.g. email address) before it’s used by Anthropic. We may use your feedback to analyze the effectiveness of our Services, conduct research, study user behavior, and train our AI models as permitted under applicable laws. We do not combine your feedback with your other conversations with Claude.","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":"Here’s an example of what you’ll see when using the thumbs up / down button to provide a feedback report:","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"image","url":"https://downloads.intercomcdn.com/i/o/lupk8zyo/1486990077/3e3aca2c94d3fb363c58829a5112/image.png?expires=1785178800\u0026signature=3a2510ff16b67ed4e0960abfdd7dc372b5332733df52b207ff343c43a7d3bcab\u0026req=dSQvEMB3nYFYXvMW1HO4zdLW1HKgCD3QS2MKBI2FW5WTH1CU3B%2BtPEQW1hZ0%0Avi3gI3rG60Y2KsaMrKE%3D%0A","width":882,"height":530,"displayWidth":500}],"collectionId":"10672565","description":"","id":"10500871","lastUpdated":"Updated over 4 months ago","lastUpdatedDate":"2026-03-16T21:06:49Z","markdown":null,"relatedArticles":[{"title":"Is my data used for model training?","url":"https://privacy.claude.com/en/articles/7996868-is-my-data-used-for-model-training"},{"title":"How do you use personal data in model training?","url":"https://privacy.claude.com/en/articles/7996885-how-do-you-use-personal-data-in-model-training"},{"title":"How long do you store my data?","url":"https://privacy.claude.com/en/articles/10023548-how-long-do-you-store-my-data"},{"title":"How Do You Use Personal Data in Model Training?","url":"https://privacy.claude.com/en/articles/10023555-how-do-you-use-personal-data-in-model-training"},{"title":"How do I change my model improvement privacy settings?","url":"https://privacy.claude.com/en/articles/12109829-how-do-i-change-my-model-improvement-privacy-settings"}],"targetUserType":"everyone","title":"Is my data used for model training?","showTableOfContents":true,"synced":false,"isStandaloneApp":false},"breadcrumbs":[{"url":"https://privacy.claude.com/en/collections/10663362-consumers","name":"Consumers "},{"url":"https://privacy.claude.com/en/collections/10672565-data-handling-retention","name":"Data Handling \u0026 Retention"}],"selectedReaction":null,"showReactions":true,"themeCSSCustomProperties":{"--body-bg":"rgb(255, 255, 255)","--body-image":"none","--body-bg-rgb":"255, 255, 255","--body-border":"rgb(230, 230, 230)","--body-primary-color":"#1a1a1a","--body-secondary-color":"#595959","--body-reaction-bg":"rgb(242, 242, 242)","--body-reaction-text-color":"rgb(89, 89, 89)","--body-toc-active-border":"#737373","--body-toc-inactive-border":"#f2f2f2","--body-toc-inactive-color":"#595959","--body-toc-active-font-weight":400,"--body-table-border":"rgb(204, 204, 204)","--body-color":"hsl(0, 0%, 0%)","--footer-bg":"rgb(25, 25, 25)","--footer-image":"none","--footer-border":"rgb(50, 50, 50)","--footer-color":"hsl(60, 14%, 93%)","--header-bg":"rgb(240, 239, 235)","--header-image":"none","--header-color":"hsl(0, 0%, 10%)","--collection-card-bg":"rgb(204, 120, 92)","--collection-card-image":"none","--collection-card-color":"hsl(60, 14%, 93%)","--card-bg":"rgb(255, 255, 255)","--card-border-color":"rgb(230, 230, 230)","--card-border-inner-radius":"11px","--card-border-radius":