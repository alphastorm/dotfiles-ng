[user]
  name = Sunil Srivatsa
  email = sunilsrivatsa@gmail.com
  signingKey = 235DE76E36B33C14
[core]
  pager = diff-so-fancy | less --tabs=4 -RFX
  # No fsmonitor here. It keeps one daemon per worktree, and with a few hundred
  # worktrees FSEvents fell behind until git waited on a daemon without end.
  # Where status is slow without it: git config core.fsmonitor true, in that repository.
  untrackedCache = true
	excludesfile = /Users/srs/.gitignore_global
[alias]
  l = "!. ~/.githelpers && pretty_git_log"
  r = !GIT_NO_PAGER=1 git l -30
  patch = !git --no-pager diff --no-color
[fetch]
  prune = true
[init]
  defaultBranch = main
[pull]
  rebase = true
[push]
  default = current
  autoSetupRemote = true
	followTags = false
[rerere]
  enabled = true
[include]
  path = ~/.config/.gitconfig.local
[commit]
  gpgSign = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
